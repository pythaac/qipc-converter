<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><AssemblyName>QIPCConverter</AssemblyName><RootNamespace>QipcConverter</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
    <OutputPath>artifacts\ide\</OutputPath><ApplicationManifest>src\app.manifest</ApplicationManifest>
    <ApplicationIcon>artifacts\app.ico</ApplicationIcon><Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup><Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/></ItemGroup>
  <ItemGroup><Compile Include="src\Core.cs"/><Compile Include="src\Program.cs"/><Compile Include="src\MainForm.cs"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="vendor\ffmpeg.gz"><LogicalName>QipcConverter.ffmpeg.gz</LogicalName></EmbeddedResource></ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets"/>
</Project>
